{
  "trailingComma": "none",
  "htmlWhitespaceSensitivity": "ignore",
  "singleAttributePerLine": false,
  "printWidth": 120,
  "plugins": [
    "prettier-plugin-apex",
    "@prettier/plugin-xml"
  ],
  "overrides": [
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc",
        "singleAttributePerLine": false,
        "printWidth": 120
      }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": {
        "parser": "html",
        "singleAttributePerLine": false,
        "printWidth": 120
      }
    }
  ]
}
