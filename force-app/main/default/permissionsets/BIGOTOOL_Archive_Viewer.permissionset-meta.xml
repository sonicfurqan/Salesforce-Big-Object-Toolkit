<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read-only access to archived records and the BIGOTOOL dashboard. Visibility of each generated archive Big Object is controlled by assigning the dedicated BIGOTOOL_Archive_&lt;Object&gt; permission set created by the generation engine.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>BIGOTOOL Archive Viewer</label>
    <applicationVisibilities>
        <application>Big_Object_Tooling</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>BIGOTOOL_DashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BIGOTOOL_ArchiveViewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>BIGOTOOL_Dashboard</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Archive_Job_Log__b</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Archive_Job_Log__b.Status__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Archive_Job_Log__b.RecordsProcessed__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Archive_Job_Log__b.RecordsFailed__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Archive_Job_Log__b.ErrorSummary__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Archive_Job_Log__b.AsyncJobId__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
