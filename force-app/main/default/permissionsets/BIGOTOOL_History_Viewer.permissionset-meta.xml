<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Read-only access to field change history records (FieldChangeLog Big Object) and the Big Object Tooling app.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>BIGOTOOL History Viewer</label>
    <applicationVisibilities>
        <application>Big_Object_Tooling</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>BIGOTOOL_HistoryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>FieldChangeLog__b</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.FieldApiName__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.FieldLabel__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.OldValue__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.NewValue__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.ChangedByUserId__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.ChangeType__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>FieldChangeLog__b.TransactionId__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
